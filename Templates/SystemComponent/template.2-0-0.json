{
  "$schemaVersion": "2.0.0",
  "$schema": "https://canonical.o3de.org/o3de-template-2.0.0.json",
  "template": {
    "name": "org.o3de.template.systemcomponent",
    "version": "0.0.0",
    "display_name": "Default System Component Template",
    "description": "A component template for a typical system component.",
    "type": "",
    "id": "",
    "copyright_text": ""
  },
  "copyFiles": [
    {
      "file": "Source/${Name}SystemComponent.cpp",
      "isTemplated": true
    },
    {
      "file": "Source/${Name}SystemComponent.h",
      "isTemplated": true
    },
    {
      "file": "Include/${GemName}/${Name}Interface.h",
      "isTemplated": true,
      "isInterface": true,
      "cleanup_hint": "interface",
      "condition": "add_bus_interface"
    },
    {
      "file": "Source/Tools/Editor${Name}SystemComponent.h",
      "isTemplated": true,
      "isEditor": true,
      "cleanup_hint": "editor",
      "condition": "include_editor"
    },
    {
      "file": "Source/Tools/Editor${Name}SystemComponent.cpp",
      "isTemplated": true,
      "isEditor": true,
      "cleanup_hint": "editor",
      "condition": "include_editor"
    }
  ],
  "createDirectories": [
    {
      "dir": "Include/${GemName}"
    },
    {
      "dir": "Source"
    }
  ],
  "origin": {
    "name": "Open 3D Engine - o3de.org",
    "url": "https://github.com/o3de/o3de"
  },
  "licenses": [
    {
      "license_identifier": "Apache-2.0 or MIT",
      "url": "https://github.com/o3de/o3de/blob/development/LICENSE.txt",
      "display_name": "Apache 2.0 or MIT",
      "relative_path": ""
    }
  ],
